# ============================================================
# 模型配置文件（供本目录下的 llm_config.py 读取）
#
# 作用范围：与 llm_config.py 同目录
#   加载路径由 llm_config.py 按自身所在目录解析，因此
#   从任何工作目录运行本目录的脚本，读到的都是这一份配置。
#
# 用法：
#   换模型只需改 MODEL_PROVIDER 这一行，代码不用动
#   自检命令（在本目录执行）：python llm_config.py
# ============================================================

# ============================================================
# 模型来源（MODEL_PROVIDER 的可选值）
#   ollama_direct  直连 Ollama，默认 deepseek-r1:32b（当前默认）
#   qwen_vl        直连同一个 Ollama，默认 qwen3-vl:8b
#   gateway        内网 OpenAI 兼容网关（见下方 GATEWAY_* 段）
#   ollama         本机 Ollama（localhost:11434/v1）
#   openai         OpenAI 官方 API，需 OPENAI_API_KEY
#   deepseek       DeepSeek API，需 DEEPSEEK_API_KEY
#   dashscope      阿里云百炼，需 DASHSCOPE_API_KEY
#
# 同一个 Ollama 服务上，不同模型的 tools 支持情况是不同的：
#   deepseek-r1:32b  -> Ollama 明确不支持 tools，只能走文本解析版 ReAct
#   qwen3-vl:8b      -> 支持 OpenAI tools 协议，可以做结构化工具调用
# 因此代码里统一用 llm_config.supports_tools() 探测，别按模型名字猜。
# ============================================================
MODEL_PROVIDER=ollama_direct

# ============================================================
# 直连 Ollama（当前默认）
#   一个地址对全部模型，具体用哪个由 *_MODEL 指定；无需 Key
#
#   注意 max_tokens 要给足：deepseek-r1:32b、qwen3-vl:8b 都是推理模型，
#   先把 token 花在 reasoning 上，预算不足时会拿到空正文（或丢掉 tool_calls）。
# ============================================================
OLLAMA_DIRECT_BASE_URL=http://192.168.3.10:11434/v1
OLLAMA_DIRECT_MODEL=deepseek-r1:32b
QWEN_VL_MODEL=qwen3-vl:8b

# tools 能力探测
#   留空 = 每次启动时探测一次（结果按「地址+模型」缓存）
#   0 / 1 = 直接指定，省掉这次探测请求
MODEL_SUPPORTS_TOOLS=

# ============================================================
# 内网 OpenAI 兼容网关（MODEL_PROVIDER=gateway 时使用）
#   只代理 /v1/chat/completions，不提供 /models，故自检会退到 /health 判断
#
#   注意这个网关的两个行为（实测）：
#     1. 忽略请求里的 model 字段 —— 填什么都不影响实际调用的模型，
#        GATEWAY_MODEL 只是"请求里署的名"，真实模型以服务端为准
#     2. 会转发 tools 字段，可做结构化工具调用
# ============================================================
GATEWAY_BASE_URL=http://192.168.3.10:7889/v1
GATEWAY_MODEL=qwen2.5-vl
GATEWAY_API_KEY=not-needed

# ============================================================
# 本机 Ollama（MODEL_PROVIDER=ollama 时使用）
# 安装：brew install ollama      启动：ollama serve
# 下载模型：ollama pull qwen2.5:7b-instruct
# ============================================================
OLLAMA_BASE_URL=http://localhost:11434/v1
OLLAMA_MODEL=qwen2.5:7b-instruct

# ============================================================
# OpenAI 官方
# ============================================================
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_API_KEY=sk-替换为你的OpenAIKey
OPENAI_MODEL=gpt-4o-mini

# ============================================================
# DeepSeek
# 获取：https://platform.deepseek.com/api_keys
# ============================================================
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
DEEPSEEK_API_KEY=sk-替换为你的DeepSeekKey
DEEPSEEK_MODEL=deepseek-chat

# ============================================================
# 阿里云百炼 DashScope
# 获取：https://bailian.console.aliyun.com/#/api-key
# ============================================================
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
DASHSCOPE_API_KEY=sk-替换为你的DashScopeKey
DASHSCOPE_MODEL=qwen-plus

# ============================================================
# 模型参数（所有来源通用）
# 推理模型的 max_tokens 里包含 reasoning 部分，给太小会截断
# ============================================================
MODEL_TEMPERATURE=0
MODEL_MAX_TOKENS=3000
MODEL_TOP_P=1.0
MODEL_TIMEOUT=300
MODEL_MAX_RETRIES=3

# ============================================================
# 网络设置
#   MODEL_TRUST_ENV
#     0 = 直连，忽略 shell 里的 http_proxy/https_proxy（内网服务必须直连）
#     1 = 跟随系统代理环境变量
#   no_proxy 对 localhost 等内网地址兜底放行
# ============================================================
no_proxy=localhost,127.0.0.1,192.168.3.10
MODEL_TRUST_ENV=0
